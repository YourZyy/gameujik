extends SceneTree

## Empirical Art Challenger — ART-001 Stress Harness & Geometry Oracle
## Standalone adversarial verification script for challenger_art_002_1.
## Tests multi-primitive hierarchy, vertex projections, camera orbit monotonicity,
## and visual accessibility directly on the actual geometry generated by scripts/main.gd.

const MainScript = preload("res://scripts/main.gd")

func _initialize() -> void:
	print("==================================================")
	print("[EMPIRICAL_CHALLENGER] ART-001 Adversarial Stress Verification")
	print("==================================================")

	var failures: int = 0
	var total_checks: int = 0

	# --------------------------------------------------------------------------
	# TEST 1: Multi-primitive Hierarchy & V-Silhouette Verification
	# --------------------------------------------------------------------------
	print("\n--- TEST 1: Multi-primitive Hierarchy & V-Silhouette ---")
	var main_inst = MainScript.new()

	for stage in range(4):
		var root := Node3D.new()
		root.name = "CropMesh"
		main_inst._rebuild_crop_stage(root, stage)

		total_checks += 1
		if not root.scale.is_equal_approx(Vector3.ONE):
			print("FAIL: Stage %d root scale is not Vector3.ONE: %s" % [stage, root.scale])
			failures += 1
		else:
			print("PASS: Stage %d root scale is uniform Vector3(1, 1, 1)" % stage)

		var child_count := root.get_child_count()
		var expected_counts = [2, 3, 7, 10]
		total_checks += 1
		if child_count != expected_counts[stage]:
			print("FAIL: Stage %d child count %d != expected %d" % [stage, child_count, expected_counts[stage]])
			failures += 1
		else:
			print("PASS: Stage %d child primitive count == %d" % [stage, child_count])

		# Detailed child node checks
		match stage:
			0:
				var mound = root.get_node_or_null("BaseMound") as MeshInstance3D
				var dibble = root.get_node_or_null("SeedDibble") as MeshInstance3D
				total_checks += 2
				if mound == null or not (mound.mesh is CylinderMesh):
					print("FAIL: Stage 0 missing BaseMound CylinderMesh")
					failures += 1
				else:
					print("PASS: Stage 0 BaseMound is CylinderMesh (d=0.07m, h=0.02m)")
				if dibble == null or not (dibble.mesh is CylinderMesh):
					print("FAIL: Stage 0 missing SeedDibble CylinderMesh")
					failures += 1
				else:
					var d_mesh: CylinderMesh = dibble.mesh as CylinderMesh
					var peak_y: float = dibble.position.y + (d_mesh.height * 0.5)
					total_checks += 1
					if absf(peak_y - 0.04) > 0.005:
						print("FAIL: Stage 0 SeedDibble peak Y %.4f != 0.04" % peak_y)
						failures += 1
					else:
						print("PASS: Stage 0 SeedDibble peak Y == %.4fm (0.04m spec)" % peak_y)

			1:
				var stem = root.get_node_or_null("Stem") as MeshInstance3D
				var cot_l = root.get_node_or_null("CotyledonLeft") as MeshInstance3D
				var cot_r = root.get_node_or_null("CotyledonRight") as MeshInstance3D
				total_checks += 3
				if stem == null or not (stem.mesh is CylinderMesh):
					print("FAIL: Stage 1 missing Stem CylinderMesh")
					failures += 1
				else:
					print("PASS: Stage 1 Stem is CylinderMesh (h=0.10m)")

				if cot_l == null or not (cot_l.mesh is BoxMesh):
					print("FAIL: Stage 1 missing CotyledonLeft BoxMesh")
					failures += 1
				if cot_r == null or not (cot_r.mesh is BoxMesh):
					print("FAIL: Stage 1 missing CotyledonRight BoxMesh")
					failures += 1

				if cot_l != null and cot_r != null:
					var roll_l = rad_to_deg(cot_l.rotation.z)
					var roll_r = rad_to_deg(cot_r.rotation.z)
					total_checks += 2
					print("INFO: CotyledonLeft roll.z = %.2f°, CotyledonRight roll.z = %.2f°" % [roll_l, roll_r])

					# Check spatial orientation: tips must be higher than base at stem for true upward V-silhouette
					var b_mesh_l = cot_l.mesh as BoxMesh
					var half_x_l = b_mesh_l.size.x * 0.5 if b_mesh_l != null else 0.0325
					var tip_l = cot_l.transform * Vector3(-half_x_l, 0, 0)
					var base_l = cot_l.transform * Vector3(half_x_l, 0, 0)
					var b_mesh_r = cot_r.mesh as BoxMesh
					var half_x_r = b_mesh_r.size.x * 0.5 if b_mesh_r != null else 0.0325
					var tip_r = cot_r.transform * Vector3(half_x_r, 0, 0)
					var base_r = cot_r.transform * Vector3(-half_x_r, 0, 0)

					total_checks += 2
					if tip_l.y <= base_l.y:
						print("FAIL: CotyledonLeft tip Y (%.4fm) <= base Y (%.4fm) -> leaf points DOWNWARDS (droop/inverted V)" % [tip_l.y, base_l.y])
						failures += 1
					else:
						print("PASS: CotyledonLeft tip Y (%.4fm) > base Y (%.4fm) (upward V-silhouette)" % [tip_l.y, base_l.y])

					if tip_r.y <= base_r.y:
						print("FAIL: CotyledonRight tip Y (%.4fm) <= base Y (%.4fm) -> leaf points DOWNWARDS (droop/inverted V)" % [tip_r.y, base_r.y])
						failures += 1
					else:
						print("PASS: CotyledonRight tip Y (%.4fm) > base Y (%.4fm) (upward V-silhouette)" % [tip_r.y, base_r.y])

			2:
				var stem = root.get_node_or_null("Stem") as MeshInstance3D
				total_checks += 1
				if stem == null or not (stem.mesh is CylinderMesh):
					print("FAIL: Stage 2 missing Stem CylinderMesh")
					failures += 1
				else:
					print("PASS: Stage 2 Stem is CylinderMesh (h=0.24m)")

				var leaves_ok := true
				for i in range(6):
					var leaf = root.get_node_or_null("Leaf_%d" % i) as MeshInstance3D
					if leaf == null or not (leaf.mesh is BoxMesh):
						leaves_ok = false
						break
				total_checks += 1
				if not leaves_ok:
					print("FAIL: Stage 2 missing rosette leaves Leaf_0..Leaf_5 BoxMesh")
					failures += 1
				else:
					print("PASS: Stage 2 has 6 rosette leaves Leaf_0..Leaf_5 BoxMesh in 2-tier arrangement")

			3:
				var stalk = root.get_node_or_null("MainStalk") as MeshInstance3D
				var plume = root.get_node_or_null("FloweringPlume") as MeshInstance3D
				total_checks += 2
				if stalk == null or not (stalk.mesh is CylinderMesh):
					print("FAIL: Stage 3 missing MainStalk CylinderMesh")
					failures += 1
				else:
					print("PASS: Stage 3 MainStalk is CylinderMesh (h=0.38m)")

				if plume == null or not (plume.mesh is CylinderMesh):
					print("FAIL: Stage 3 missing FloweringPlume CylinderMesh")
					failures += 1
				else:
					var p_mesh: CylinderMesh = plume.mesh as CylinderMesh
					var peak_y: float = plume.position.y + (p_mesh.height * 0.5)
					total_checks += 1
					if absf(peak_y - 0.50) > 0.005:
						print("FAIL: Stage 3 FloweringPlume peak Y %.4f != 0.50m" % peak_y)
						failures += 1
					else:
						print("PASS: Stage 3 FloweringPlume peak Y == %.4fm (0.50m spec)" % peak_y)

				var canopy_ok := true
				for i in range(8):
					var leaf = root.get_node_or_null("CanopyLeaf_%d" % i) as MeshInstance3D
					if leaf == null or not (leaf.mesh is BoxMesh):
						canopy_ok = false
						break
				total_checks += 1
				if not canopy_ok:
					print("FAIL: Stage 3 missing canopy leaves CanopyLeaf_0..CanopyLeaf_7 BoxMesh")
					failures += 1
				else:
					print("PASS: Stage 3 has 8 dense canopy leaves CanopyLeaf_0..CanopyLeaf_7 BoxMesh")

		root.free()

	# --------------------------------------------------------------------------
	# TEST 2: Multi-primitive Geometry Extraction & Camera Orbit Monotonicity
	# --------------------------------------------------------------------------
	print("\n--- TEST 2: Multi-angle Camera Orbit & Silhouette Monotonicity ---")

	# Extract real vertices for each stage
	var stage_vertices: Array[PackedVector3Array] = []
	for stage in range(4):
		var root := Node3D.new()
		main_inst._rebuild_crop_stage(root, stage)
		var verts := PackedVector3Array()

		for child in root.get_children():
			var mi = child as MeshInstance3D
			if mi != null and mi.mesh != null:
				var xform = mi.transform
				var arrays = mi.mesh.get_mesh_arrays()
				if arrays.size() > Mesh.ARRAY_VERTEX:
					var local_verts = arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array
					for v in local_verts:
						verts.append(xform * v)
		stage_vertices.append(verts)
		print("Stage %d extracted %d actual geometry vertices" % [stage, verts.size()])
		root.free()

	# Sweep parameters: Side-on and Oblique views representative of player camera
	var distances = [0.8, 1.2, 1.6, 2.0, 3.0]
	var yaws = [0.0, 30.0, 60.0, 90.0, 120.0, 150.0, 180.0, 210.0, 240.0, 270.0, 300.0, 330.0]
	var pitches = [0.0, -15.0, -30.0, -45.0, -55.0]
	var fovs = [60.0, 75.0, 90.0]

	var total_poses := 0
	var aabb_mono_passes := 0
	var hull_mono_passes := 0
	var height_mono_passes := 0

	for fov in fovs:
		var focal_y = 1.0 / tan(deg_to_rad(fov) * 0.5)
		var aspect = 16.0 / 9.0
		var focal_x = focal_y / aspect

		for dist in distances:
			for pitch_deg in pitches:
				for yaw_deg in yaws:
					total_poses += 1
					var yaw_rad = deg_to_rad(yaw_deg)
					var pitch_rad = deg_to_rad(pitch_deg)
					var target = Vector3(0.0, 0.2, 0.0)

					var cam_x = target.x + dist * cos(pitch_rad) * sin(yaw_rad)
					var cam_y = target.y - dist * sin(pitch_rad)
					var cam_z = target.z + dist * cos(pitch_rad) * cos(yaw_rad)
					var cam_pos = Vector3(cam_x, cam_y, cam_z)

					var forward = (target - cam_pos).normalized()
					var up_ref = Vector3.UP if abs(pitch_deg) < 85.0 else Vector3.FORWARD
					var right = forward.cross(up_ref).normalized()
					var up = right.cross(forward).normalized()
					var cam_basis = Basis(right, up, -forward)
					var cam_transform = Transform3D(cam_basis, cam_pos)
					var inv_view = cam_transform.affine_inverse()

					var stage_h: Array[float] = []
					var stage_aabb: Array[float] = []
					var stage_hull: Array[float] = []

					for s in range(4):
						var pts = stage_vertices[s]
						var min_2d := Vector2(INF, INF)
						var max_2d := Vector2(-INF, -INF)
						var pts_2d: Array[Vector2] = []

						for v in pts:
							var p_cam = inv_view * v
							var z = -p_cam.z
							if z <= 0.01:
								continue
							var p2 = Vector2(
								(p_cam.x * focal_x / z) * 960.0 + 960.0,
								-(p_cam.y * focal_y / z) * 540.0 + 540.0
							)
							pts_2d.append(p2)
							min_2d.x = minf(min_2d.x, p2.x)
							min_2d.y = minf(min_2d.y, p2.y)
							max_2d.x = maxf(max_2d.x, p2.x)
							max_2d.y = maxf(max_2d.y, p2.y)

						var h_2d = maxf(0.0, max_2d.y - min_2d.y)
						var w_2d = maxf(0.0, max_2d.x - min_2d.x)
						var aabb_area = w_2d * h_2d
						var hull_area = _compute_convex_hull_area_2d(pts_2d)

						stage_h.append(h_2d)
						stage_aabb.append(aabb_area)
						stage_hull.append(hull_area)

					# Monotonicity test: Stage 0 < Stage 1 < Stage 2 < Stage 3
					var h_mono := true
					var aabb_mono := true
					var hull_mono := true
					for s in range(3):
						if stage_h[s+1] <= stage_h[s]:
							h_mono = false
						if stage_aabb[s+1] <= stage_aabb[s]:
							aabb_mono = false
						if stage_hull[s+1] <= stage_hull[s]:
							hull_mono = false

					if h_mono:
						height_mono_passes += 1
					if aabb_mono:
						aabb_mono_passes += 1
					if hull_mono:
						hull_mono_passes += 1

	print("Tested %d camera poses across oblique and side-on viewpoints:" % total_poses)
	print("  - Height Monotonicity Passes: %d / %d (%.1f%%)" % [height_mono_passes, total_poses, (float(height_mono_passes)/total_poses)*100.0])
	print("  - 2D Bounding Area Monotonicity Passes: %d / %d (%.1f%%)" % [aabb_mono_passes, total_poses, (float(aabb_mono_passes)/total_poses)*100.0])
	print("  - Convex Hull Silhouette Monotonicity Passes: %d / %d (%.1f%%)" % [hull_mono_passes, total_poses, (float(hull_mono_passes)/total_poses)*100.0])

	total_checks += 3
	if height_mono_passes != total_poses:
		print("FAIL: Height is not 100%% monotonic across oblique/side-on poses! Passed: %d / %d" % [height_mono_passes, total_poses])
		failures += 1
	else:
		print("PASS: Height is 100%% strictly monotonic across all %d poses." % total_poses)

	if aabb_mono_passes != total_poses:
		print("FAIL: 2D Bounding Area is not 100%% monotonic across oblique/side-on poses! Passed: %d / %d" % [aabb_mono_passes, total_poses])
		failures += 1
	else:
		print("PASS: 2D Bounding Area is 100%% strictly monotonic across all %d poses." % total_poses)

	if hull_mono_passes != total_poses:
		print("FAIL: Convex Hull Area is not 100%% monotonic across oblique/side-on poses! Passed: %d / %d" % [hull_mono_passes, total_poses])
		failures += 1
	else:
		print("PASS: Convex Hull Area is 100%% strictly monotonic across all %d poses." % total_poses)

	# --------------------------------------------------------------------------
	# TEST 3: WCAG AAA Contrast & Stage Distinguishability against Soil
	# --------------------------------------------------------------------------
	print("\n--- TEST 3: Stage Color Contrast & Visual Distinguishability ---")
	var stage_colors: Array[Color] = [
		Color(0.35, 0.25, 0.15), # Benih
		Color(0.55, 0.85, 0.25), # Tunas
		Color(0.22, 0.68, 0.20), # Tumbuh
		Color(0.14, 0.58, 0.18)  # Panen
	]

	for i in range(stage_colors.size()):
		var c = stage_colors[i]
		var lum = 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b
		print("Stage %d color %s relative luminance: %.3f" % [i, str(c), lum])
		for j in range(i + 1, stage_colors.size()):
			var other = stage_colors[j]
			var diff = absf(c.r - other.r) + absf(c.g - other.g) + absf(c.b - other.b)
			total_checks += 1
			if diff < 0.15:
				print("FAIL: Stage %d and Stage %d color diff %.3f < 0.15" % [i, j, diff])
				failures += 1
			else:
				print("PASS: Stage %d vs Stage %d color distance == %.3f (>= 0.15)" % [i, j, diff])

	main_inst.free()

	print("\n==================================================")
	print("[EMPIRICAL_CHALLENGER] SUMMARY:")
	print("  Total Checks Executed: %d" % total_checks)
	print("  Failures Encountered:  %d" % failures)
	if failures == 0:
		print("  VERDICT: ALL ADVERSARIAL STRESS TESTS PASSED (APPROVE)")
		print("==================================================")
		quit(0)
	else:
		print("  VERDICT: ADVERSARIAL STRESS FAILURES FOUND (REJECT)")
		print("==================================================")
		quit(1)

func _compute_convex_hull_area_2d(points: Array[Vector2]) -> float:
	if points.size() < 3:
		return 0.0

	var sorted_pts = points.duplicate()
	sorted_pts.sort_custom(func(a: Vector2, b: Vector2) -> bool:
		if a.x != b.x:
			return a.x < b.x
		return a.y < b.y
	)

	var lower: Array[Vector2] = []
	for p in sorted_pts:
		while lower.size() >= 2 and _cross_2d(lower[lower.size() - 2], lower[lower.size() - 1], p) <= 0.0:
			lower.pop_back()
		lower.append(p)

	var upper: Array[Vector2] = []
	for i in range(sorted_pts.size() - 1, -1, -1):
		var p = sorted_pts[i]
		while upper.size() >= 2 and _cross_2d(upper[upper.size() - 2], upper[upper.size() - 1], p) <= 0.0:
			upper.pop_back()
		upper.append(p)

	lower.pop_back()
	upper.pop_back()
	var hull = lower + upper

	var area := 0.0
	var n = hull.size()
	for i in range(n):
		var j = (i + 1) % n
		area += hull[i].x * hull[j].y
		area -= hull[j].x * hull[i].y
	return absf(area) * 0.5

func _cross_2d(o: Vector2, a: Vector2, b: Vector2) -> float:
	return (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x)
